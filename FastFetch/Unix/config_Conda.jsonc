{
	// The Conda terminal's panel - the Unix twin of FastFetch/Windows/Conda/config_Conda_*.jsonc,
	// drawn by the Conda entry of WezTerm's launch menu (WezTerm/wezterm.lua) once the base
	// environment is active: the Mac panel's modules (battery included) in the Conda green, with
	// the active environment ($CONDA_DEFAULT_ENV) under the shell. The logo file,
	// FastFetch/Unix/FastFetchLogo_Conda.txt, is passed with --logo by the launch menu entry, so the
	// config holds no machine path.
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "file",
		"padding": {
			"top": 2
		},
		"color": {
			"1": "38;2;68;204;102"
		}
	},
	"display": {
		"separator": " -> ",
		"color": {
			"separator": "38;2;68;204;102"
		}
	},
	"modules": [
		{
			"type": "custom",
			"format": "╭───────────────╮"
		},
		{
			"type": "title",
			"color": {
				"user": "38;2;68;204;102",
				"at": "38;2;255;255;255",
				"host": "38;2;68;204;102"
			}
		},
		{
			"type": "custom",
			"format": "╰───────────────╯"
		},
		{
			"type": "custom",
			"format": "╭────────────────────────────────────────────────────────────────╮"
		},
		{
			"type": "os",
			"key": "    OS",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "shell",
			"key": "    Shell",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"key": "  󱔎  Environment",
			"format": "{$CONDA_DEFAULT_ENV}",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			// showPeCoreCount is meaningful on Apple Silicon too - it reports the
			// performance/efficiency core split. temp is kept for parity with the
			// Windows config, but macOS exposes no CPU temperature to an unprivileged
			// process, so fastfetch simply omits it rather than failing.
			"type": "cpu",
			"key": "  󰻠  CPU",
			"showPeCoreCount": true,
			"temp": true,
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "gpu",
			"temp": true,
			"key": "  󰍛  GPU",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "memory",
			"key": "  󰑭  Memory",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "display",
			"key": "  󰍹  Display",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "• ────────────────────────────────────────────────────────────── •"
		},
		{
			"type": "disk",
			"key": "    Disk",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "• ────────────────────────────────────────────────────────────── •"
		},
		{
			"type": "battery",
			"key": "  󰁹  Battery",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "uptime",
			"key": "  󰅐  Uptime",
			"keyColor": "38;2;68;204;102",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "╰────────────────────────────────────────────────────────────────╯"
		},
		{
			"type": "colors",
			"paddingLeft": 2,
			"symbol": "circle"
		},
		"break"
	]
}
