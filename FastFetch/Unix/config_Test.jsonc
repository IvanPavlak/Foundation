{
	// The Test machine type's fastfetch panel - the Unix twin of FastFetch/Windows/config_Test.jsonc,
	// linked to ~/.config/fastfetch/config.jsonc by chezmoi (Unix/home/dot_config/fastfetch); a
	// machine type without a file of its own gets config_Test.jsonc.
	//
	// Module list, keys, colours and box drawing are deliberately identical to the Windows config,
	// so the panel reads the same on every machine.
	//
	// The logo below is the TEXT logo: the TEST banner of FastFetchLogo_Test.txt (linked
	// next to this file by chezmoi), as on Windows. It is what Terminal.app, SSH
	// and a piped run show. In WezTerm and Ghostty the `image-logo` line of Unix/config/greeting.conf
	// for this machine type (Universal.FastFetchImageLogo of Windows) replaces it with an image,
	// passed by Invoke-Fastfetch on the command line.
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "file",
		"source": "~/.config/fastfetch/FastFetchLogo_Test.txt",
		"padding": {
			"top": 7
		},
		"color": {
			"1": "38;2;30;144;255"
		}
	},
	"display": {
		"separator": " -> ",
		"color": {
			"separator": "38;2;255;0;0"
		}
	},
	"modules": [
		{
			"type": "custom",
			"format": "╭───────────────╮"
		},
		{
			"type": "title",
			"color": {
				"user": "38;2;30;144;255",
				"at": "38;2;255;0;0",
				"host": "38;2;30;144;255"
			}
		},
		{
			"type": "custom",
			"format": "╰───────────────╯"
		},
		{
			"type": "custom",
			"format": "╭────────────────────────────────────────────────────────────────╮"
		},
		{
			"type": "os",
			"key": "    OS",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "shell",
			"key": "    Shell",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			// showPeCoreCount is meaningful on Apple Silicon too - it reports the
			// performance/efficiency core split. temp is kept for parity with the
			// Windows config, but macOS exposes no CPU temperature to an unprivileged
			// process, so fastfetch simply omits it rather than failing.
			"type": "cpu",
			"key": "  󰻠  CPU",
			"showPeCoreCount": true,
			"temp": true,
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "gpu",
			"temp": true,
			"key": "  󰍛  GPU",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "memory",
			"key": "  󰑭  Memory",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "display",
			"key": "  󰍹  Display",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "• ────────────────────────────────────────────────────────────── •"
		},
		{
			"type": "disk",
			"key": "    Disk",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "• ────────────────────────────────────────────────────────────── •"
		},
		{
			"type": "battery",
			"key": "  󰁹  Battery",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "uptime",
			"key": "  󰅐  Uptime",
			"keyColor": "38;2;30;144;255",
			"outputColor": "white"
		},
		{
			"type": "custom",
			"format": "╰────────────────────────────────────────────────────────────────╯"
		},
		{
			"type": "colors",
			"paddingLeft": 2,
			"symbol": "circle"
		},
		"break"
	]
}
