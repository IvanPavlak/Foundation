#!/bin/sh
# git-obsidian - commits and pushes all pending changes in the Obsidian vault repository.
# Unix port of WinuX's Windows/PowerShell/Modules/Git/Functions/Git-Obsidian.ps1.
#
# Deliberately an executable POSIX script rather than a sourced shell function:
# a script runs in its own /bin/sh process, so it behaves byte-for-byte the same
# under zsh, bash, dash, ksh and fish, and cannot collide with shell-specific
# reserved names. The previous function version broke under zsh, where `status`
# is a read-only parameter, which silently swallowed every result message.
#
# Vault path comes from $OBSIDIAN_DIRECTORY, else the `directory` line of
# Unix/config/obsidian.conf (the $MachineSpecificPaths.ObsidianDirectory analog), read
# through the shared config library under the system bash.
#
# The script never changes the caller's working directory: `cd` here affects only
# this process.
#
# Whether to push is decided from the unpushed-commit count against the upstream, not from
# the working tree alone: a run whose push failed (no network) leaves a clean tree with a
# commit the remote never received, and the next run must finish that push instead of
# reporting "No changes to update!".
#
# Exit codes: 0 = pushed, or nothing to do. 1 = failure (commit or push did not succeed).
# -h / --help prints this header and touches nothing; any other argument is an error.
#
# Usage: git-obsidian [-h | --help]

set -u

# Before anything else: a help request (or a typo) must never commit or push.
case ${1:-} in
	-h | --help)
		awk 'NR == 1 && /^#!/ { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
		exit 0
		;;
	'') ;;
	*)
		printf 'git-obsidian: unknown argument => %s (git-obsidian takes none; --help shows the usage)\n' "$1" >&2
		exit 1
		;;
esac

# $0 must be captured here, at top level. zsh's FUNCTION_ARGZERO option is on by
# default and rewrites $0 to the *function* name inside a function, so reading $0
# from within resolve_repository_root silently yields the wrong directory
# whenever this script is interpreted by zsh instead of /bin/sh.
script_path=$0

# Resolve the script through any symlinks, then walk up bin/ -> <Module>/ -> modules/ -> Unix/ -> root, so
# it works whether it is run from PATH or through a ~/.local/bin symlink.
resolve_repository_root() {
	resolved=$1

	while [ -L "$resolved" ]; do
		link_target=$(readlink "$resolved")
		case $link_target in
			/*) resolved=$link_target ;;
			*) resolved=$(dirname "$resolved")/$link_target ;;
		esac
	done

	# No path component to walk up from: let the caller fall back to the default.
	case $resolved in
		*/*) ;;
		*) return 1 ;;
	esac

	CDPATH='' cd -- "$(dirname -- "$resolved")/../../../.." && pwd -P
}

DOTFILES_ROOT=${DOTFILES_ROOT:-$(resolve_repository_root "$script_path")}

if [ ! -r "$DOTFILES_ROOT/Unix/lib/log.sh" ]; then
	printf 'git-obsidian: cannot find Unix/lib/log.sh under %s\n' "$DOTFILES_ROOT" >&2
	printf 'git-obsidian: set DOTFILES_ROOT to the repository root and retry\n' >&2
	exit 1
fi

. "$DOTFILES_ROOT/Unix/lib/log.sh"

obsidian_directory=${OBSIDIAN_DIRECTORY:-$(/bin/bash -c '. "$1/Unix/lib/foundation.sh" >/dev/null 2>&1 && foundation_load config obsidian && obsidian_directory' _ "$DOTFILES_ROOT")}
if [ -z "$obsidian_directory" ]; then
	log_error "No Obsidian vault configured - set directory in Unix/config/obsidian.conf"
	exit 1
fi

log_title "Git-Obsidian"

if [ ! -d "$obsidian_directory" ]; then
	log_error "Obsidian vault not found: $obsidian_directory"
	exit 1
fi

cd "$obsidian_directory" || {
	log_error "Cannot enter Obsidian vault: $obsidian_directory"
	exit 1
}

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	log_error "Not a git repository: $obsidian_directory"
	exit 1
fi

changes=$(git status --porcelain) || {
	log_error "Error updating Obsidian!"
	exit 1
}

if [ -n "$changes" ]; then
	# One blank line between the title and git's own output (the status messages below bring
	# their own leading newline).
	printf '\n'

	# -A rather than `.` so the result is identical regardless of the git version's
	# treatment of deletions. The vault root is the repository root, so the two are
	# equivalent in practice; -A just states the intent unambiguously.
	if ! git add -A || ! git commit -m "Vault Backup: $(date '+%d.%m.%Y | %H:%M')"; then
		log_error "Commit failed - nothing was pushed!"
		log_warning "The changes are still in the working tree. Fix the cause and run git-obsidian again."
		exit 1
	fi
fi

# Decide whether to push from what the remote is missing, not from the working tree: a
# clean tree says nothing about whether the last commit ever left this machine. rev-list
# fails when the branch has no upstream; treat that as "unknown" and let git push report
# the real problem rather than hiding it behind "No changes".
if ! unpushed=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null); then
	unpushed=
fi

if [ -z "$changes" ] && [ "$unpushed" = "0" ]; then
	log_warning "No changes to update!"
	exit 0
fi

if [ -z "$changes" ]; then
	if [ -z "$unpushed" ]; then
		log_warning "Could not compare the branch with its upstream. Pushing so git reports the cause..."
	else
		log_warning "Found [$unpushed] unpushed commit(s) from an earlier run. Pushing..."
	fi
	printf '\n'
fi

if git push; then
	log_success "Obsidian updated!"
else
	log_error "Push failed - the vault is committed locally but the remote was not updated!"
	log_warning "Run git-obsidian again once the remote is reachable; it will push the pending commit(s)."
	exit 1
fi
