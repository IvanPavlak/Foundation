#!/usr/bin/env bash
# Update-Repositories - clones missing repositories and updates existing ones without losing local work.
#
# Usage: Update-Repositories [NAME...] [--all] [--archive] [--in-current-directory]
#                            [--no-clone] [--quiet]
#                            [--include-default-branch | --no-include-default-branch]
#        Update-Repositories --group GROUP... | --repositories NAME... [OPTIONS]
#        Update-Repositories --repository-url URL --local-path DIR [OPTIONS]
#
# Repositories and groups come from Unix/config/repositories.conf. Without arguments the menu of
# the groups with their repositories nested under them is shown, as on Windows: a group or a
# repository by number (1, 1.2) or name. A bare name is a repository, the positional -Repositories;
# an unknown one is reported and the others run.
# Repositories run in file order and each folder at most once (a repository listed in two groups,
# or two entries with the same DIR); entries that share a name but not a folder all run.
#
# A missing directory is cloned (base URL + path; `--depth 1` when the line ends in
# `shallow`, a clone that can still commit and push). An existing checkout is updated the safe way
# (Unix/lib/repository.sh): a path that is not the top of its own repository, a merge, rebase,
# cherry-pick, revert or bisect in progress, unresolved conflicts, or a detached HEAD is left
# alone; local changes, untracked files included, are stashed by commit and restored exactly
# (staged changes stay staged); the branch is fetched and only fast-forwarded, never merged, and
# never over an ignored local file; a branch origin does not have, or an origin that cannot be
# reached, is reported instead of pulled. A stash that cannot be restored cleanly is kept.
#
#   --all                        every repository
#   --group GROUP...             the Windows -Group: every name is a group; one that is not
#                                aborts the call with the configured groups, nothing updated
#   --repositories NAME...       the Windows -Repositories: every name is a repository, never a
#                                group of the same name
#   --repository-url URL --local-path DIR
#                                one repository outside repositories.conf (the Windows custom
#                                mode): cloned into DIR when missing, updated safely otherwise
#                                (shallow when a `shallow` line of the file has the same URL)
#   --archive                    clone without history (shallow, .git removed) into
#                                <root>/<archive=FOLDER>/<name>, never the configured path, as on
#                                Windows: the root is ~/Desktop, or `archive-root` of
#                                repositories.conf (absolute, or relative to ~/Desktop), and the
#                                FOLDER of a repository line is a relative path of any depth,
#                                absent meaning the root itself; one whose folder exists is
#                                skipped with a warning; an archive run prints its own lines, no
#                                group headings, summaries or totals, with or without --quiet, and
#                                never honors --no-clone
#   --in-current-directory       clone (and update) into ./<name> instead of the configured
#                                paths; with --archive the current folder is the root and each
#                                line's archive=FOLDER still applies (the Windows
#                                -InCurrentDirectory)
#   --no-clone                   report missing repositories as skipped instead of cloning them
#   --quiet                      the title, then one line per repository plus a totals line, git
#                                silenced except for a clone; each line and count colored by its
#                                bucket (updated green, up to date white, need attention red,
#                                skipped yellow), and a repository's stashes listed under its
#                                line, one and two tabs in, in white
#   --include-default-branch     also fast-forward each default branch while another one is
#                                checked out (git fetch origin <default>:<default>); default from
#                                `include-default-branch on|off` in repositories.conf
#   --no-include-default-branch  turn that off for this run
#
# --all, --group, --repositories and the URL/path pair are separate modes, as the Windows parameter
# sets: one per call, and the pair takes no names. `A,B` names two groups or repositories; a flag it
# does not know is an error.
# A run over several groups prints a heading per group, with or without --quiet.
# Every run opens with the title Windows prints: [Updating All Repositories] for --all,
# [Updating [GROUP, ...] Repositories] for --group or one group picked in the menu,
# [Updating Specified Repository] for the URL/path pair, [Updating Selected Repositories] otherwise.
# Exit status 1 when a repository needs attention (could not be updated or restored).
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_load config repository

foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

file=$(conf_path repositories.conf) || foundation_die "Missing Unix/config/repositories.conf"
base=$(conf_value "$file" base) || base=https://github.com

# A top-level `KEY VALUE` of repositories.conf for this machine type (@TYPE lines), the last
# match winning. Usage: setting KEY DEFAULT
setting() {
	local key=$1 value=$2 line k v
	while IFS= read -r line; do
		read -r k v <<<"$line"
		foundation_ieq "$k" "$key" && value=$v
	done < <(conf_lines "$file")
	printf '%s' "$value"
}

names=()
all=0
archive=0
in_current=0
no_clone=0
quiet=0
include_default=''
mode=''
custom_url=''
custom_dir=''
# One mode per call, as the Windows parameter sets. Usage: set_mode MODE
set_mode() {
	[ -z "$mode" ] || [ "$mode" = "$1" ] || foundation_die "--$mode and --$1 are separate modes - nothing was updated"
	mode=$1
}
while [ $# -gt 0 ]; do
	case $1 in
		--all) all=1 ;;
		--archive) archive=1 ;;
		--in-current-directory) in_current=1 ;;
		--no-clone) no_clone=1 ;;
		--quiet) quiet=1 ;;
		--include-default-branch) include_default=1 ;;
		--no-include-default-branch) include_default=0 ;;
		--group) set_mode group ;;
		--repositories) set_mode repositories ;;
		--repository-url | --local-path)
			set_mode repository-url
			[ $# -ge 2 ] || foundation_die "$1 needs a value - nothing was updated"
			if [ "$1" = --repository-url ]; then custom_url=$2; else custom_dir=$2; fi
			shift
			;;
		-v | --verbose) ;;
		-*) foundation_die "Unknown argument => $1 - nothing was updated" ;;
		*) foundation_split_list names "$1" ;;
	esac
	shift
done
# A bare name is a repository, as the positional -Repositories on Windows.
[ -n "$mode" ] || [ ${#names[@]} -eq 0 ] || mode=repositories
[ "$all" -eq 0 ] || [ -z "$mode" ] || foundation_die "--all and --$mode are separate modes - nothing was updated"
case $mode in
	repository-url)
		[ -n "$custom_url" ] && [ -n "$custom_dir" ] || foundation_die "--repository-url and --local-path go together - nothing was updated"
		[ ${#names[@]} -eq 0 ] || foundation_die "--repository-url takes no group or repository names - nothing was updated"
		;;
	group | repositories)
		[ ${#names[@]} -gt 0 ] || foundation_die "--$mode needs at least one name - nothing was updated"
		;;
esac
if [ -z "$include_default" ]; then
	case $(foundation_lower "$(setting include-default-branch off)") in on | true | yes | 1) include_default=1 ;; *) include_default=0 ;; esac
fi
REPO_DEFAULT_CONFIGURED=$(setting default-branch '')
export REPO_DEFAULT_CONFIGURED

# Where an archive run lands: --in-current-directory wins over `archive-root`, which is absolute
# or relative to the Desktop.
archive_base=$HOME/Desktop
if [ "$in_current" -eq 1 ]; then
	archive_base=$PWD
else
	archive_root=$(foundation_expand_path "$(setting archive-root '')")
	case $archive_root in
		'') ;;
		/*) archive_base=$archive_root ;;
		*) archive_base=$archive_base/$archive_root ;;
	esac
fi

groups=()
while IFS= read -r group; do groups+=("$group"); done < <(conf_sections "$file")
# What to run: whole groups first, then repositories by name, as the Windows menu resolves them.
group_names=()
repository_names=()
from_menu=0
if [ "$all" -eq 1 ]; then
	group_names=("${groups[@]}")
elif [ "$mode" = group ]; then
	# Every name is checked first, as Resolve-RepositoryTargets: a typo updates nothing instead of
	# half the groups.
	resolved=$(repo_scope_groups "$file" '' "${names[@]}") || exit 1
	while IFS= read -r name; do [ -n "$name" ] && group_names+=("$name"); done <<<"$resolved"
elif [ "$mode" = repositories ]; then
	repository_names=("${names[@]}")
elif [ -z "$mode" ]; then
	# The menu of Windows: each group, its repositories nested under it (GROUP.REPOSITORY).
	nodes=()
	for group in "${groups[@]}"; do
		nodes+=("$group")
		while read -r repo _; do [ -n "$repo" ] && nodes+=("$group.$repo"); done < <(conf_section "$file" "$group")
	done
	selection=$(foundation_resolve_tree_selection "[Available Repositories]" "Enter repository/repositories by number or name" 0 1 "${nodes[@]}") || exit 1
	while IFS= read -r name; do
		case $name in
			'') ;;
			*.*) repository_names+=("${name#*.}") ;;
			*) group_names+=("$name") ;;
		esac
	done <<<"$selection"
	from_menu=1
fi

# The title the Windows parameter sets print, before the names resolve; --group prints its own
# once it knows which groups carry repositories.
title="Updating Selected Repositories"
if [ "$all" -eq 1 ]; then
	title="Updating All Repositories"
elif [ "$mode" = repository-url ]; then
	title="Updating Specified Repository"
elif [ "$from_menu" -eq 1 ] && [ ${#group_names[@]} -eq 1 ] && [ ${#repository_names[@]} -eq 0 ]; then
	title="Updating [${group_names[0]}] Repositories"
fi
[ "$mode" = group ] || log_title "$title"

# Collect "GROUP LINE" (LINE as repositories.conf writes it) in file order. The URL/path pair is
# one entry of its own, under the group `-`, shallow when a `shallow` line has the same URL.
selected=''
if [ "$mode" = repository-url ]; then
	custom_name=${custom_url%/}
	custom_name=${custom_name##*[:/]}
	custom_name=${custom_name%.git}
	shallow_word=''
	repo_url_shallow "$file" "$(repo_resolve_url "$custom_url" "$base")" && shallow_word=' shallow'
	selected="- ${custom_name:-repository} $custom_url $custom_dir$shallow_word"$'\n'
fi
for name in ${group_names[@]+"${group_names[@]}"}; do
	lines=$(conf_section "$file" "$name") || continue
	while IFS= read -r line; do [ -n "$line" ] && selected+="$name $line"$'\n'; done <<<"$lines"
done
for name in ${repository_names[@]+"${repository_names[@]}"}; do
	found=0
	for group in "${groups[@]}"; do
		while IFS= read -r line; do
			read -r repo _ <<<"$line"
			if [ -n "$repo" ] && foundation_ieq "$repo" "$name"; then
				selected+="$group $line"$'\n'
				found=1
			fi
		done < <(conf_section "$file" "$group")
	done
	[ "$found" -eq 1 ] || log_error "Error: Repository [$name] not found in configuration!"
done

# A run over several groups prints one heading per group; an archive run prints none, as on Windows.
distinct_groups=$(printf '%s' "$selected" | awk 'NF && !seen[$1]++' | wc -l | tr -d ' ')

# A --group title echoes the configured spelling of the groups that carry repositories, or what
# was asked for when every requested group turned out empty, as on Windows.
if [ "$mode" = group ]; then
	title_groups=$(printf '%s' "$selected" | awk 'NF && !seen[$1]++ { printf "%s%s", (n++ ? ", " : ""), $1 }')
	if [ -z "$title_groups" ]; then
		title_groups=$(printf '%s, ' "${names[@]}")
		title_groups=${title_groups%, }
	fi
	log_title "Updating [$title_groups] Repositories"
fi

seen=$'\n'
current_group=''
first_after_heading=1
updated=0
up_to_date=0
attention=0
skipped=0
while read -r group line; do
	[ -n "$line" ] || continue
	repo_entry "$line"
	repo=$REPO_ENTRY_NAME
	shallow=$REPO_ENTRY_SHALLOW
	dir=$(foundation_expand_path "$REPO_ENTRY_DIR")
	# Each folder once, as Windows dedupes by LocalPath: a repository listed in two groups is
	# updated once, two entries that only share a name are not merged. Without a folder on this
	# machine the name is the key.
	key=$dir
	[ -n "$key" ] || key="name:$repo"
	case $seen in *$'\n'"$key"$'\n'*) continue ;; esac
	seen="$seen$key"$'\n'
	url=$(repo_resolve_url "$REPO_ENTRY_SOURCE" "$base")
	# Printed under the repository's own name, from its URL, like Get-RepositoryName on Windows:
	# /Owner/My_Repo.git is [My_Repo], whatever the entry is called.
	name=${url%/}
	name=${name##*[:/]}
	name=${name%.git}
	[ -n "$name" ] || name=$repo
	# As on Windows: an archive never lands in the configured path (a later normal run expects a
	# clone there) but under its root and folder, and --in-current-directory puts everything here.
	if [ "$archive" -eq 1 ]; then
		dir=$archive_base/${REPO_ENTRY_ARCHIVE:+$REPO_ENTRY_ARCHIVE/}$name
	elif [ "$in_current" -eq 1 ]; then
		dir=$PWD/$name
	fi
	if [ "$archive" -eq 0 ] && [ "$distinct_groups" -gt 1 ] && [ "$group" != "$current_group" ]; then
		current_group=$group
		log_title "$group"
		first_after_heading=1
	fi

	# Archive mode only ever clones, and prints its own lines, as on Windows.
	if [ "$archive" -eq 1 ]; then
		if [ -e "$dir" ]; then
			log_warning "Skipping [$name] => Already exists at [$dir]"
			continue
		fi
		log_step " Archiving [$name] to [$dir]"
		mkdir -p "$(dirname "$dir")"
		if ! git clone --depth 1 "$url" "$dir" </dev/null; then
			log_error "Failed to download [$name]!"
			attention=$((attention + 1))
			continue
		fi
		rm -rf "$dir/.git"
		log_step " Removed .git directory"
		log_success "Downloaded [$name] without git history!"
		continue
	fi

	if [ -z "$dir" ]; then
		repo_result "$name" NotConfigured
		[ "$quiet" -eq 1 ] || log_warning "Skipping [$name] => LocalPath not configured for this machine!"
	elif [ -e "$dir" ]; then
		repo_update "$name" "$dir" "$include_default" "$quiet"
	elif [ "$no_clone" -eq 1 ]; then
		repo_result "$name" NotCloned
		[ "$quiet" -eq 1 ] || log_warning "Repository [$name] not found at [$dir] - not cloned (--no-clone)"
	else
		# Printed with --quiet too, as Windows: a clone is never silent.
		log_warning "Repository [$name] not found at [$dir]"
		log_title "Initializing [$name] Repository"
		log_step "  Cloning [$name] to [$dir]"
		mkdir -p "$(dirname "$dir")"
		clone=(git clone)
		# A shallow entry (`Shallow` on Windows) keeps its .git: a clone that can commit and push.
		[ "$shallow" -eq 1 ] && clone+=(--depth 1)
		outcome=Error
		"${clone[@]}" "$url" "$dir" </dev/null && outcome=Cloned
		repo_result "$name" "$outcome"
	fi

	repo_format_result
	case $REPO_CATEGORY in
		Updated) updated=$((updated + 1)) ;;
		UpToDate) up_to_date=$((up_to_date + 1)) ;;
		Skipped) skipped=$((skipped + 1)) ;;
		*) attention=$((attention + 1)) ;;
	esac
	if [ "$quiet" -eq 1 ]; then
		# A blank line separates the title, a group heading or the previous repository's stash
		# list from the next repository; the rest of the group's lines follow without one.
		lead=-n
		[ "$first_after_heading" -eq 1 ] && lead=''
		# Colored by bucket: updated green, up to date white, need attention red, skipped yellow.
		case $REPO_CATEGORY in
			Updated) log_success ${lead:+"$lead"} "$REPO_LINE" ;;
			UpToDate) log_step ${lead:+"$lead"} "=> $REPO_LINE" ;;
			Skipped) log_segments ${lead:+"$lead"} warning "=> $REPO_LINE" ;;
			*) log_error ${lead:+"$lead"} "$REPO_LINE" ;;
		esac
		# The stashes the repository holds, whoever made them, so none is forgotten. Only for a
		# folder that is its own repository: git -C anywhere else would list the stashes of
		# whichever repository encloses it (an archive copy has no .git of its own).
		stashes=''
		case $REPO_OUTCOME in
			NotConfigured | NotCloned | NotARepository) ;;
			*)
				if cdup=$(git -C "$dir" rev-parse --show-cdup 2>/dev/null) && [ -z "$cdup" ]; then
					stashes=$(git -C "$dir" stash list 2>/dev/null)
				fi
				;;
		esac
		if [ -n "$stashes" ]; then
			log_step $'\t* Stashes =>'
			while IFS= read -r stash; do
				[ -n "$stash" ] && log_step -n $'\t\t'"* $stash"
			done <<<"$stashes"
			first_after_heading=1
			continue
		fi
	fi
	first_after_heading=0
done <<<"$selected"

# Quiet only, and never for an archive run, as on Windows. Each count in the color of its
# repository lines, whatever its value: updated green, up to date white, need attention red,
# skipped yellow.
if [ "$quiet" -eq 1 ] && [ "$archive" -eq 0 ]; then
	log_segments '' "=> Repositories => " success "$updated updated" '' ", " '' "$up_to_date up to date" '' ", " \
		error "$attention need attention" '' ", " warning "$skipped skipped"
fi
[ "$attention" -eq 0 ] || exit 1
