#!/usr/bin/env bash
# GitBranchDeleteAndPrune - deletes local branches and prunes stale origin refs. Alias: gbd
#
# Usage: GitBranchDeleteAndPrune [BRANCH... | --branch-name BRANCH...] [--force]
#
# Each BRANCH is deleted with `git branch -d`, which refuses one that is not fully merged into its
# upstream or HEAD (a squash-merged branch included); the refused ones are named and offered once
# for `git branch -D`, Enter meaning No. --force deletes with -D straight away and asks nothing.
# BRANCH may also be given as --branch-name BRANCH (the Windows -BranchName), and `a, b` works as
# in PowerShell; a flag it does not know is an error, never a branch name. Without BRANCH the
# local branches (the checked-out one left out) are offered in a menu that takes one or more;
# Enter deletes nothing and exits 0. `git remote prune origin` runs once, only when at least one
# branch was deleted. Exit status 1 when a branch was not deleted.
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

branches=()
force=0
while [ $# -gt 0 ]; do
	case $1 in
		--branch-name | -v | --verbose) ;;
		--force) force=1 ;;
		-*) foundation_die "Unknown argument => $1" ;;
		*) foundation_split_list branches "$1" ;;
	esac
	shift
done

if [ ${#branches[@]} -eq 0 ]; then
	# Full refs, so a tag of the same name never makes a short name ambiguous.
	refs=$(git for-each-ref --format='%(refname)' refs/heads/) || exit 1
	current=$(git symbolic-ref -q HEAD) || current=''
	options=()
	while IFS= read -r ref; do
		[ -n "$ref" ] && [ "$ref" != "$current" ] && options+=("${ref#refs/heads/}")
	done <<<"$refs"
	if [ ${#options[@]} -eq 0 ]; then
		log_warning "No local branch to delete besides the checked-out one"
		exit 0
	fi
	selection=$(foundation_resolve_selection "[Local Branches]" "Enter branch(es) to delete by number or name, or press [Enter] to delete none" 1 1 "${options[@]}") || exit 1
	while IFS= read -r name; do [ -n "$name" ] && branches+=("$name"); done <<<"$selection"
	[ ${#branches[@]} -gt 0 ] || exit 0
	# Keeps the answer apart from git's output below it.
	printf '\n' >&2
fi

# Each branch on its own, so one that fails does not keep the others; prune once at the end,
# and only when something was deleted.
flag=-d
[ "$force" -eq 1 ] && flag=-D
failed=0
deleted=0
refused=()
for name in "${branches[@]}"; do
	if git branch "$flag" "$name"; then deleted=$((deleted + 1)); else refused+=("$name"); fi
done

# Only a plain delete asks: --force already used -D, and a branch -D refuses (missing, checked
# out in a worktree) would only fail again.
if [ ${#refused[@]} -gt 0 ]; then
	failed=1
	if [ "$force" -eq 0 ]; then
		list=$(printf '%s, ' "${refused[@]}")
		list=${list%, }
		log_warning "Not deleted: $list (not fully merged, or see git's message above)"
		if foundation_confirm "[Unmerged Branches]" "Force-delete $list with git branch -D?"; then
			printf '\n' >&2
			failed=0
			for name in "${refused[@]}"; do
				if git branch -D "$name"; then deleted=$((deleted + 1)); else failed=1; fi
			done
		fi
	fi
fi
if [ "$deleted" -gt 0 ]; then
	git remote prune origin || failed=1
fi
exit "$failed"
