#!/usr/bin/env bash
# Update-DirectoryNames - moves the date at the end of folder names to today's date.
#
# Usage: Update-DirectoryNames [PATH] [--dry-run]
#
# The Unix twin of the Windows Update-DirectoryNames. Every folder directly under PATH (default: the
# current folder) whose name ends in _YYYY_MM_DD is renamed to end in today's date instead
# (Report_2026_01_31 => Report_2026_10_22); a name that is only a date becomes today's date. A
# folder already dated today is left alone, and so is one whose new name is taken. --dry-run (the
# -WhatIf of Windows) prints what would be renamed and renames nothing.
# Windows-style names: --path (-Path) is accepted and ignored: the PATH after it is the folder.
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1

foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

path=$PWD
dry=0
for argument in "$@"; do
	case $argument in
		--dry-run | --what-if) dry=1 ;;
		--path) ;;
		-v | --verbose) ;;
		-*) foundation_die "Unknown argument => $argument" ;;
		*) path=$argument ;;
	esac
done
[ -d "$path" ] || foundation_die "No such folder => [$path]"

today=$(date +%Y_%m_%d)
changed=0
failed=0
for directory in "$path"/*/; do
	[ -d "$directory" ] || continue
	name=$(basename "$directory")
	[[ $name =~ ^(.*_)?([0-9]{4}_[0-9]{2}_[0-9]{2})$ ]] || continue
	prefix=${BASH_REMATCH[1]}
	if [ "${BASH_REMATCH[2]}" = "$today" ]; then
		log_step "  \"$name\" is already up to date!"
		continue
	fi
	new_name=$prefix$today
	if [ -e "$path/$new_name" ]; then
		log_warning "Not renaming \"$name\" - \"$new_name\" already exists"
		failed=1
		continue
	fi
	if [ "$dry" -eq 1 ]; then
		log_warning " Would rename \"$name\" -> \"$new_name\""
	elif mv "$path/$name" "$path/$new_name"; then
		log_success "Renaming \"$name\" -> \"$new_name\""
	else
		log_error "Error renaming \"$name\""
		failed=1
		continue
	fi
	changed=1
done
[ "$changed" -eq 1 ] || [ "$failed" -eq 1 ] || log_step "  All directories are up to date!"
exit "$failed"
