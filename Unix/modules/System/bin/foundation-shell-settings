#!/usr/bin/env bash
# foundation-shell-settings - prints the settings a new interactive shell applies, for Unix/shell/shellrc.sh.
#
# Usage: foundation-shell-settings [--prompt-theme]
#
# One `KEY VALUE` line each: prompt-theme (the Oh My Posh theme, see foundation-prompt-theme),
# eza-colors (the list-color lines of theme.conf as an EZA_COLORS value, when there are any), one
# `app TOKEN` line per apps.conf token (for the Open-<TOKEN> aliases), then the line-editing
# settings of Unix/config/shell.conf for this machine type, the .local overlay applied (the last
# line of a kind wins): history-size, history-file (expanded), edit-mode, history-no-duplicates,
# history-save-style, completion-ignore-case, prediction-source, prediction-view, the list's
# prediction-list-marker and colours (color-list-prediction, color-list-prediction-selected, color-emphasis), and one `bindkey SEQUENCE WIDGET` line per key binding, the
# `key` lines translated by lib/lineediting.sh over the Windows-mode keys of `edit-mode windows`.
# A setting without a valid line is left out, so the shell keeps its own default. One process for
# both startup stages: each helper run costs a new shell about a tenth of a second.
# --prompt-theme prints the theme path alone. Keeps no session log of its own (one per terminal
# would push the real command logs out).
export FOUNDATION_LOGGING=off
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_load config apps lineediting

# The prompt-theme line of theme.conf, {MachineType} replaced; the shipped theme without one.
theme=''
file=$(conf_path theme.conf) && theme=$(conf_value "$file" prompt-theme 2>/dev/null)
[ -n "$theme" ] || theme='$DOTFILES_ROOT/Oh-My-Posh/WinuX_Test.omp.json'
theme=${theme//\{MachineType\}/$(foundation_machine_type)}
theme=$(foundation_expand_path "$theme")
if [ "${1:-}" = --prompt-theme ]; then
	printf '%s\n' "$theme"
	exit 0
fi
printf 'prompt-theme %s\n' "$theme"

# The list-color lines of theme.conf, as one EZA_COLORS value for the ls, ll, la and l aliases.
if [ -n "$file" ]; then
	colors=$(conf_lines "$file" | while read -r kind rest; do
		[ "${kind,,}" = list-color ] && printf '%s\n' "$rest"
	done | lineediting_eza_colors)
	[ -n "$colors" ] && printf 'eza-colors %s\n' "$colors"
fi

while IFS= read -r token; do
	[ -n "$token" ] && printf 'app %s\n' "$token"
done < <(apps_list | cut -f1)

file=$(conf_path shell.conf) || exit 0
# One pass over the effective lines: the last valid line of each scalar kind wins, the key lines
# keep their order for lineediting_bindings.
declare -A setting=()
keys=''
while read -r kind rest; do
	kind=${kind,,}
	case $kind in
		key) keys+="$rest"$'\n' ;;
		history-size | history-file | edit-mode | history-no-duplicates | history-save-style | completion-ignore-case | prediction-source | prediction-view | prediction-list-marker | color-list-prediction | color-list-prediction-selected | color-emphasis)
			value=$(lineediting_setting "$kind" "$rest") && setting[$kind]=$value
			;;
	esac
done < <(conf_lines "$file")
[ -n "${setting["history-file"]:-}" ] && setting["history-file"]=$(foundation_expand_path "${setting["history-file"]}")
for kind in history-size history-file edit-mode history-no-duplicates history-save-style completion-ignore-case prediction-source prediction-view prediction-list-marker color-list-prediction color-list-prediction-selected color-emphasis; do
	[ -n "${setting[$kind]:-}" ] && printf '%s %s\n' "$kind" "${setting[$kind]}"
done
while read -r sequence widget; do
	[ -n "$widget" ] && printf 'bindkey %s %s\n' "$sequence" "$widget"
done < <(printf '%s' "$keys" | lineediting_bindings "${setting["edit-mode"]:-}")
exit 0
