#!/usr/bin/env bash
# Open-Acrobat - opens PDF groups in Adobe Acrobat, or the default PDF viewer without it.
#
# Usage: Open-Acrobat [GROUP...] [--pdf GROUP...]
#
# GROUP is a section of Unix/config/pdfs.conf (AcrobatPdfGroups); every PDF of it is opened. A
# GROUP may also be a comma list (MyProject,Learning), and --pdf (Windows' -Pdf) may stand before
# the groups. As on Windows, a call without any argument opens Acrobat itself (or says it is
# already running) without a menu, and `--pdf ''` shows the menu: the groups, then up to 10
# recently used PDFs (Spotlight's last-used date of the last 90 days, newest first, so a PDF read
# in any viewer counts; Acrobat's own recent list is not readable outside Acrobat); an empty Enter
# opens Acrobat itself. A GROUP given as a menu number, or as a menu entry `Recent: NAME.pdf`, is
# that entry of the menu, as -Pdf is on Windows. Acrobat is the `Acrobat` app of apps.conf; when
# it is not installed the files open in the default PDF viewer (Preview), so the command still
# does its job on a Mac without Adobe.
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_load config apps

foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

groups=()
recent_chosen=()
menu=0
for argument in "$@"; do
	case $argument in
		--pdf) menu=1 ;;
		-v | --verbose) ;;
		*)
			IFS=, read -r -a names <<<"$argument"
			groups+=("${names[@]}")
			;;
	esac
done

acrobat=''
bundle=$(app_bundle Acrobat 2>/dev/null) && app_installed "$bundle" >/dev/null && acrobat=$bundle
open_pdf() { # FILE
	if [ -n "$acrobat" ]; then foundation_launch open -b "$acrobat" "$1" </dev/null; else foundation_launch open "$1" </dev/null; fi
}
# Acrobat itself, as Start-Application does: a running one is a warning, not a second launch.
open_acrobat() {
	[ -n "$acrobat" ] || foundation_die "Adobe Acrobat is not installed (brew install --cask adobe-acrobat-reader)"
	if [ -n "$(app_pids "$acrobat")" ]; then
		log_warning "Acrobat is already running!"
		exit 0
	fi
	foundation_launch open -b "$acrobat" </dev/null && log_success "Acrobat opened!"
	exit 0
}

# Up to 10 PDFs used in the last 90 days, newest first (Spotlight's kMDItemLastUsedDate).
recent_pdfs() {
	local path used
	mdfind 'kMDItemContentType == "com.adobe.pdf" && kMDItemLastUsedDate >= $time.today(-90)' 2>/dev/null </dev/null | head -n 200 |
		while IFS= read -r path; do
			[ -f "$path" ] || continue
			used=$(mdls -raw -name kMDItemLastUsedDate "$path" 2>/dev/null </dev/null)
			case $used in '' | '(null)') continue ;; esac
			printf '%s\t%s\n' "$used" "$path"
		done | sort -r | head -n 10 | cut -f2-
}

file=$(conf_path pdfs.conf) || foundation_die "Missing Unix/config/pdfs.conf"
[ ${#groups[@]} -gt 0 ] || [ "$menu" -eq 1 ] || open_acrobat
recent=()
given=0
[ ${#groups[@]} -eq 0 ] || given=1
# The menu's list: for the menu, and for a number or a "Recent: NAME" entry given as a name, which
# name that entry of it, as -Pdf 2 does on Windows. Plain group names need no Spotlight query.
if [ "$given" -eq 0 ] || foundation_has_number "${groups[@]}" || [[ " $(foundation_lower "${groups[*]}")" == *" recent: "* ]]; then
	available=()
	while IFS= read -r name; do available+=("$name"); done < <(conf_sections "$file")
	while IFS= read -r path; do [ -n "$path" ] && recent+=("$path"); done < <(recent_pdfs)
	options=(${available[@]+"${available[@]}"})
	for path in ${recent[@]+"${recent[@]}"}; do options+=("Recent: ${path##*/}"); done
	if [ "$given" -eq 1 ]; then
		selection=$(foundation_resolve_items "${groups[@]}" -- ${options[@]+"${options[@]}"})
		groups=()
	else
		selection=$(foundation_resolve_selection "[Available PDF Groups]" "Enter group(s) or recent PDF(s), or press [Enter] to open Acrobat" 1 1 "${options[@]}") || exit 1
	fi
	while IFS= read -r name; do
		[ -n "$name" ] || continue
		case $name in
			"Recent: "*)
				# Back to its path: the first recent PDF of that file name.
				for path in "${recent[@]}"; do
					[ "Recent: ${path##*/}" = "$name" ] && recent_chosen+=("$path") && break
				done
				;;
			*) groups+=("$name") ;;
		esac
	done <<<"$selection"
fi
[ ${#groups[@]} -gt 0 ] || [ ${#recent_chosen[@]} -gt 0 ] || open_acrobat
[ -n "$acrobat" ] || log_debug "[Open-Acrobat] Acrobat is not installed - using the default PDF viewer"

status=0
for pdf in ${recent_chosen[@]+"${recent_chosen[@]}"}; do
	open_pdf "$pdf" && log_step "Opened recent PDF [${pdf##*/}]"
done
for group in "${groups[@]}"; do
	name=$(conf_section_name "$file" "$group") || {
		log_error "No PDF group [$group] in pdfs.conf"
		status=1
		continue
	}
	log_step "Opening PDF group [$name]..."
	while IFS= read -r pdf; do
		[ -n "$pdf" ] || continue
		pdf=$(foundation_expand_path "$pdf")
		if [ ! -f "$pdf" ]; then
			log_error "PDF not found => $pdf"
			status=1
			continue
		fi
		open_pdf "$pdf" && log_step "  ${pdf##*/}"
	done < <(conf_section "$file" "$name")
done
[ "$status" -eq 0 ] && [ ${#groups[@]} -gt 0 ] && log_success "PDF group(s) opened!"
exit $status
