#!/usr/bin/env bash
# Deploy-AiArtifacts - links the repository's AI skills, mods, rules, prompts and agents into the AI
# apps this machine deploys into.
#
# Usage: Deploy-AiArtifacts [--kind KIND...] [--check]
#
# The apps are the harnesses of the `deploy` line of Unix/config/ai-artifacts.conf, each defined by
# a [section] of ai-harnesses.conf (the base catalogue: claude-code, codex, gemini-cli, copilot,
# all inactive until named); the items are every <root>/<Kind>/<source>/<item> of the sources read
# (own first, then foundation, example and the vendored sources in name order; the first wins an
# item name two carry, with a warning), minus the `exclude` lines. Design: docs/foundation/ai.md.
#
# Per destination of an app:
#   each   one link per item in the folder: the item folder itself (`.`), or the first file of the
#          destination's list the item has, named <item> plus that file's extension; an item
#          with none of them is left out
#   copy   as each, copied instead of linked; a copy that differs from the repository's is
#          replaced
#   file   one link to the item of the `use KIND NAME` line (the rules: ~/.claude/CLAUDE.md)
# A destination two apps name is filled once; one no item goes to is left alone (only pruned). A folder destination that is itself a link into the
# repository (the earlier whole-folder style) is replaced by a real folder; one that links
# elsewhere, or a file in its place, is skipped. A real file or folder where a link or a copy goes
# is first copied into Backups/Unix/SymbolicLinks/AiArtifacts.<kind>.<item> (backup_item, skip,
# never destroy: when the copy fails that item is skipped and the run fails). Only dangling links
# that point into the artifacts root are pruned; a link to anything else is never touched.
# Hooks of a destination: +claude-plugin-dirs sets env.CLAUDE_CODE_PLUGIN_DIRS of
# ~/.claude/settings.json to its links, then every entry added by hand (python3 edits the JSON;
# without it a warning), and runs `claude plugin validate` on each (a missing or rejecting CLI only
# warns); +managed-settings writes a root-owned copy through sudo instead of a link (Claude Code's
# managed settings, which no other setting overrides): the item's file rendered (the token
# {ManagedDir} becomes the destination's folder; with an AI profile, forceLoginOrgUUID from its
# Plan and the ownership guard appended to hooks.UserPromptSubmit and hooks.PreToolUse), and next
# to it the item's hooks/ folder, and with a profile ai-ownership-guard.sh and ai-profile.conf;
# each is rewritten only when it differs, root:wheel and mode 644 (a link left by an earlier run is
# replaced).
# AI profile (ai-profiles.conf, FOUNDATION_AI_PROFILE; none: everything as above): its `deploy`
# lines replace the deploy line, its `rules` line the `use rules` line, its `include` lines limit a
# kind to those items and its `exclude` lines add to the excludes. Sources (ai-artifacts.conf):
# a checkout source's items are linked from the local repository itself; a manifest source's rows
# from their pinned clone in the cache (fetched here first when missing, through git; not under
# --check; a fetch that fails is a warning), only the rows whose scope
# includes the profile, a strip-invocation-guard or renamed row from its derived copy (made here
# when missing; a rename also sets the frontmatter name:, linked under the new name); a `repo:NAME` row is linked into .claude/skills/ of that repository (repositories.conf)
# and its link name added to the repository's .git/info/exclude.
# --kind deploys only those kinds; --check (--dry-run, the Windows -WhatIf) reports what a run would
# change and changes nothing.
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_load config backup aiprofile artifacts

foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

check_only=0
kinds=()
while [ $# -gt 0 ]; do
	case $1 in
		--check | --dry-run) check_only=1 ;;
		--kind) ;;
		-v | --verbose) ;;
		-*) foundation_die "Unknown argument: $1 (expected --kind KIND... or --check)" ;;
		*)
			IFS=, read -r -a list <<<"$1"
			for kind in "${list[@]}"; do
				ai_kind_folder "$kind" >/dev/null || foundation_die "Unknown kind => [$kind] (expected one of: $(ai_kinds))"
				kinds+=("$(foundation_lower "$kind")")
			done
			;;
	esac
	shift
done

ai_profile_load
[ $? -ne 2 ] || foundation_die "AI profile: $AI_PROFILE_ERROR"

root=$(ai_root)
settings="$HOME/.claude/settings.json"
claude_cli=${FOUNDATION_CLAUDE_CLI:-claude}
# The guard is one mirror file of WinuX and Foundation, at AI/Hooks of the repository.
guard_source=$(dirname "$FOUNDATION_UNIX")/AI/Hooks/ai-ownership-guard.sh

failures=0
linked=0

log_title "Deploy-AiArtifacts"
log_step "Repository root : $DOTFILES_ROOT"
log_step "Artifacts root  : $root"
[ -z "$AI_PROFILE" ] || log_step "AI profile      : $AI_PROFILE (by $AI_PROFILE_HOW)"

if [ -z "$(ai_deployed_harnesses)" ]; then
	log_warning "No harness to deploy into - add a deploy line to ai-artifacts.conf (see ai-harnesses.conf for the catalogue)!"
	exit 0
fi
log_step "Harnesses       : $(ai_deployed_harnesses | paste -sd' ' -)"

# Runs COMMAND through sudo when ELEVATE is set, else as is. Usage: as_owner ELEVATE COMMAND...
as_owner() {
	local elevate=$1
	shift
	if [ -n "$elevate" ]; then sudo "$@"; else "$@"; fi
}

# Moves a real item at TARGET out of the way: a copy into the sink, then removal. Fails (and says
# so) when the copy fails, leaving it in place. Usage: clear_target KEY TARGET ELEVATE
clear_target() {
	local key=$1 target=$2 elevate=$3 folder
	if [ -L "$target" ]; then
		as_owner "$elevate" rm "$target"
		return
	fi
	[ -e "$target" ] || return 0
	# The copy is taken as this user: the sink is user-owned and a managed-settings file is
	# world-readable; one that is not fails the backup, and the target is then left alone.
	folder=$(backup_item SymbolicLinks "AiArtifacts.$key" "$target") || {
		log_error "SKIPPED $target (its backup failed, left untouched)"
		return 1
	}
	as_owner "$elevate" rm -rf "$target" || return 1
	log_step "backed up existing item to $folder"
}

# Reports the state of one link and, unless --check, creates it.
# Usage: link_item KEY SOURCE TARGET ELEVATE
link_item() {
	local key=$1 source_path=$2 target_path=$3 elevate=$4
	if [ -L "$target_path" ] && [ "$(readlink "$target_path")" = "$source_path" ]; then
		linked=$((linked + 1))
		return 0
	fi
	if [ "$check_only" -eq 1 ]; then
		if [ -e "$target_path" ] || [ -L "$target_path" ]; then
			log_step "WRONG   $target_path (exists, not linked to the repository)"
		else
			log_step "MISSING $target_path"
		fi
		failures=$((failures + 1))
		return 0
	fi
	if ! as_owner "$elevate" mkdir -p "$(dirname "$target_path")" ||
		! clear_target "$key" "$target_path" "$elevate" ||
		! as_owner "$elevate" ln -s "$source_path" "$target_path"; then
		failures=$((failures + 1))
		return 0
	fi
	linked=$((linked + 1))
	log_step "linked  $target_path"
}

# Reports the state of one copy and, unless --check, refreshes it. Usage: copy_item KEY SOURCE TARGET
copy_item() {
	local key=$1 source_path=$2 target_path=$3
	if [ -e "$target_path" ] && [ ! -L "$target_path" ] && diff -rq "$source_path" "$target_path" >/dev/null 2>&1; then
		linked=$((linked + 1))
		return 0
	fi
	if [ "$check_only" -eq 1 ]; then
		if [ -e "$target_path" ] || [ -L "$target_path" ]; then
			log_step "DIFFERS $target_path (not the repository's copy)"
		else
			log_step "MISSING $target_path"
		fi
		failures=$((failures + 1))
		return 0
	fi
	if ! clear_target "$key" "$target_path" '' || ! cp -R "$source_path" "$target_path"; then
		failures=$((failures + 1))
		return 0
	fi
	linked=$((linked + 1))
	log_step "copied  $target_path"
}

# Reports the state of one root-owned file of the managed settings folder and, unless --check,
# writes it from SOURCE through sudo (root:wheel, 644) when its content differs. A link in its
# place (an earlier run's) is replaced; a real file that differs is first backed up.
# Usage: managed_file KEY SOURCE TARGET
managed_file() {
	local key=$1 source_path=$2 target_path=$3
	if [ -f "$target_path" ] && [ ! -L "$target_path" ] && cmp -s "$source_path" "$target_path"; then
		linked=$((linked + 1))
		return 0
	fi
	if [ "$check_only" -eq 1 ]; then
		if [ -L "$target_path" ]; then
			log_step "WRONG   $target_path (a link; the managed settings are a root-owned copy)"
		elif [ -e "$target_path" ]; then
			log_step "DIFFERS $target_path (not the rendered copy)"
		else
			log_step "MISSING $target_path"
		fi
		failures=$((failures + 1))
		return 0
	fi
	if ! as_owner "$dest_elevate" mkdir -p "$(dirname "$target_path")" ||
		! clear_target "$key" "$target_path" "$dest_elevate" ||
		! as_owner "$dest_elevate" cp "$source_path" "$target_path" ||
		! as_owner "$dest_elevate" chown root:wheel "$target_path" ||
		! as_owner "$dest_elevate" chmod 644 "$target_path"; then
		log_error "Could not write $target_path"
		failures=$((failures + 1))
		return 0
	fi
	linked=$((linked + 1))
	log_step "copied  $target_path"
}

# The same for a folder (the rules item's hooks/): replaced whole when it differs, root:wheel,
# files 644 and folders 755. Usage: managed_tree SOURCE TARGET
managed_tree() {
	local source_path=$1 target_path=$2
	if [ -d "$target_path" ] && [ ! -L "$target_path" ] && diff -rq "$source_path" "$target_path" >/dev/null 2>&1; then
		linked=$((linked + 1))
		return 0
	fi
	if [ "$check_only" -eq 1 ]; then
		if [ -e "$target_path" ] || [ -L "$target_path" ]; then
			log_step "DIFFERS $target_path (not the rules item's hooks)"
		else
			log_step "MISSING $target_path"
		fi
		failures=$((failures + 1))
		return 0
	fi
	if ! as_owner "$dest_elevate" rm -rf "$target_path" ||
		! as_owner "$dest_elevate" cp -R "$source_path" "$target_path" ||
		! as_owner "$dest_elevate" chown -R root:wheel "$target_path" ||
		! as_owner "$dest_elevate" chmod -R u=rwX,go=rX "$target_path"; then
		log_error "Could not write $target_path"
		failures=$((failures + 1))
		return 0
	fi
	linked=$((linked + 1))
	log_step "copied  $target_path"
}

# The +managed-settings destination: the rendered managed settings at TARGET and what goes next
# to it (the item's hooks/, and with a profile the ownership guard and ai-profile.conf).
# Usage: managed_item KEY SOURCE TARGET
managed_item() {
	local key=$1 source_path=$2 target_path=$3 dir item_dir scratch
	dir=$(dirname "$target_path")
	item_dir=$(dirname "$source_path")
	scratch=$(mktemp -d) || {
		failures=$((failures + 1))
		return 0
	}
	if ai_render_managed_settings "$source_path" "$dir" >"$scratch/managed-settings.json"; then
		managed_file "$key" "$scratch/managed-settings.json" "$target_path"
	else
		log_error "SKIPPED $target_path (the managed settings of ${item_dir##*/} could not be rendered)"
		failures=$((failures + 1))
	fi
	[ ! -d "$item_dir/hooks" ] || managed_tree "$item_dir/hooks" "$dir/hooks"
	if [ -n "$AI_PROFILE" ]; then
		if [ -f "$guard_source" ]; then
			managed_file "$key.guard" "$guard_source" "$dir/ai-ownership-guard.sh"
		else
			log_error "The ownership guard is missing => $guard_source"
			failures=$((failures + 1))
		fi
		ai_profile_conf_text >"$scratch/ai-profile.conf"
		managed_file "$key.profile" "$scratch/ai-profile.conf" "$dir/ai-profile.conf"
	fi
	rm -rf "$scratch"
}

# Links the repository-scoped manifest rows (repo:NAME) into .claude/skills/ of each repository
# and lists each link name in that repository's .git/info/exclude. A repository not on this
# machine is a note; a real file where a link goes is skipped.
deploy_repository_rows() {
	local record repository link dir repo_dir folder exclude target line repositories
	repositories=$(conf_path repositories.conf) || repositories=''
	while IFS=$'\t' read -r record repository link dir; do
		case $record in
			WARN)
				log_warning "$repository"
				continue
				;;
			REPO) ;;
			*) continue ;;
		esac
		if ! repo_dir=$(ai_repository_dir "$repositories" "$repository") || [ ! -d "$repo_dir" ]; then
			log_step "NOTE    repository [$repository] of a manifest row is not on this machine (repositories.conf) - $link skipped"
			continue
		fi
		if [ ! -d "$dir" ]; then
			log_warning "Manifest row $link for [$repository] is not fetched yet - run Update-AiArtifacts"
			continue
		fi
		folder=$repo_dir/.claude/skills
		target=$folder/$link
		log_step "[repo:$repository] skills => $folder"
		if [ -e "$target" ] && [ ! -L "$target" ]; then
			log_step "SKIPPED $target (a real file or folder of the repository)"
			failures=$((failures + 1))
			continue
		fi
		exclude=$(git -C "$repo_dir" rev-parse --git-path info/exclude 2>/dev/null) || exclude=''
		[ -z "$exclude" ] || case $exclude in /*) ;; *) exclude=$repo_dir/$exclude ;; esac
		line="/.claude/skills/$link"
		if [ "$check_only" -eq 1 ]; then
			[ -L "$target" ] && [ "$(readlink "$target")" = "$dir" ] || {
				log_step "MISSING $target"
				failures=$((failures + 1))
			}
			if [ -n "$exclude" ] && ! grep -qxF -- "$line" "$exclude" 2>/dev/null; then
				log_step "MISSING $line in $exclude"
				failures=$((failures + 1))
			fi
			continue
		fi
		if ! [ -L "$target" ] || [ "$(readlink "$target")" != "$dir" ]; then
			if ! mkdir -p "$folder" || ! rm -f "$target" || ! ln -s "$dir" "$target"; then
				failures=$((failures + 1))
				continue
			fi
			log_step "linked  $target"
		fi
		linked=$((linked + 1))
		if [ -z "$exclude" ]; then
			log_warning "$repo_dir is not a git repository - $line not excluded"
		elif ! grep -qxF -- "$line" "$exclude" 2>/dev/null; then
			mkdir -p "$(dirname "$exclude")" || continue
			# A last line without its newline would run into the new one.
			[ ! -s "$exclude" ] || [ -z "$(tail -c 1 "$exclude")" ] || printf '\n' >>"$exclude"
			printf '%s\n' "$line" >>"$exclude" && log_step "excluded $line in ${exclude#"$repo_dir"/}"
		fi
	done < <(ai_manifest_repo_rows)
}

# Makes the folder of an each or copy destination ready; fails (counted) when it cannot be used.
# Usage: prepare_folder PATH
prepare_folder() {
	local folder=$1
	if [ -L "$folder" ]; then
		case "$(readlink "$folder")" in
			"$DOTFILES_ROOT"*)
				if [ "$check_only" -eq 1 ]; then
					log_step "WRONG   $folder is a folder link into the repository (will be replaced)"
					failures=$((failures + 1))
					return 1
				fi
				rm "$folder" || {
					failures=$((failures + 1))
					return 1
				}
				log_step "replaced folder link into the repository with a real folder"
				;;
			*)
				log_step "SKIPPED $folder (a link to somewhere Foundation does not manage)"
				failures=$((failures + 1))
				return 1
				;;
		esac
	elif [ -e "$folder" ] && [ ! -d "$folder" ]; then
		log_step "SKIPPED $folder (a file sits at that path)"
		failures=$((failures + 1))
		return 1
	fi
	[ "$check_only" -eq 1 ] && return 0
	mkdir -p "$folder" || {
		failures=$((failures + 1))
		return 1
	}
}

# Removes the dangling links into the artifacts root from FOLDER (reports them with --check).
# Usage: prune_folder FOLDER
prune_folder() {
	local existing
	[ -d "$1" ] || return 0
	for existing in "$1"/* "$1"/.[!.]*; do
		[ -L "$existing" ] && [ ! -e "$existing" ] || continue
		case "$(readlink "$existing")" in
			"$root"/*)
				if [ "$check_only" -eq 1 ]; then
					log_step "STALE   $existing (dangling link into the artifacts root)"
					failures=$((failures + 1))
				else
					rm "$existing" && log_step "removed dangling link $existing"
				fi
				;;
		esac
	done
}

# The claude-plugin-dirs hook: env.CLAUDE_CODE_PLUGIN_DIRS of the Claude Code settings lists LINKS
# (one per line) first, then every entry not under FOLDER; then each link is validated.
# Usage: hook_claude_plugin_dirs FOLDER LINKS
hook_claude_plugin_dirs() {
	local folder=$1 links=$2 rejected='' link
	[ -n "$links" ] || return 0
	if ! command -v python3 >/dev/null 2>&1; then
		log_warning "python3 not found - $settings was not updated; add the mod links to env.CLAUDE_CODE_PLUGIN_DIRS by hand!"
	else
		python3 - "$settings" "$folder" "$check_only" "$links" <<'PY'
import json, os, sys

path, harness, check_only, links = sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3] == "1", sys.argv[4]
deployed = [line for line in links.splitlines() if line]
key = "CLAUDE_CODE_PLUGIN_DIRS"

document = {}
if os.path.exists(path):
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
        document = json.loads(text) if text.strip() else {}
    except ValueError as error:
        print(f"Could not parse {path} - left untouched: {error}", file=sys.stderr)
        sys.exit(2)
if not isinstance(document, dict):
    print(f"The top level of {path} is not a JSON object - left untouched", file=sys.stderr)
    sys.exit(2)
env = document.get("env")
if env is None:
    env = {}
elif not isinstance(env, dict):
    print(f"The env entry in {path} is not a JSON object - left untouched", file=sys.stderr)
    sys.exit(2)

current = env.get(key, "")
merged, seen = [], set()
for entry in deployed:
    if entry not in seen:
        seen.add(entry)
        merged.append(entry)
for entry in (current.split(":") if isinstance(current, str) else []):
    trimmed = entry.rstrip("/")
    if not entry or trimmed == harness or trimmed.startswith(harness + "/"):
        continue
    if entry not in seen:
        seen.add(entry)
        merged.append(entry)
value = ":".join(merged)

if current == value:
    print(f"env.{key} in {path} is up to date")
    sys.exit(0)
if check_only:
    print(f"DIFFERS env.{key} in {path}")
    sys.exit(3)

env[key] = value
document["env"] = env
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as handle:
    json.dump(document, handle, indent=2, ensure_ascii=False)
    handle.write("\n")
print(f"Set env.{key} in {path}")
PY
		case $? in
			0) ;;
			3) failures=$((failures + 1)) ;;
			*)
				log_error "Claude Code settings not updated: $settings"
				failures=$((failures + 1))
				;;
		esac
	fi
	# The CLI is the practical gate for the mod API; it only ever warns.
	if ! command -v "$claude_cli" >/dev/null 2>&1; then
		log_warning "Claude Code CLI (claude) not found on PATH - mods are deployed but cannot be used until the Claude Code CLI is installed or updated!"
		return 0
	fi
	while IFS= read -r link; do
		[ -n "$link" ] || continue
		"$claude_cli" plugin validate "$link" >/dev/null 2>&1 || rejected="$rejected${rejected:+, }$(basename "$link")"
	done <<<"$links"
	[ -z "$rejected" ] || log_warning "claude plugin validate failed for [$rejected] - mods are deployed but cannot be used until the Claude Code CLI is updated or the mod is fixed!"
}

# Finishes the current destination: prunes its folder and runs its hooks.
finish_destination() {
	[ -n "$dest_path" ] || return 0
	if [ "$dest_ready" -ne 0 ] && [ "$dest_placement" != file ]; then
		prune_folder "$dest_path"
	fi
	case ",$dest_hooks," in
		*,claude-plugin-dirs,*) [ "$dest_ready" -eq 1 ] && hook_claude_plugin_dirs "$dest_path" "$dest_links" ;;
	esac
	dest_path=''
}

# Readies the current destination for its first item: the hooks that change how it is written,
# and its folder (each, copy). A destination without items is never created. Sets dest_ready to 1,
# or 0 when it cannot be used.
open_destination() {
	local hook
	dest_ready=1
	log_step "[$dest_harness] $dest_kind => $dest_path"
	for hook in ${dest_hooks//,/ }; do
		case $hook in
			- | claude-plugin-dirs) ;;
			managed-settings)
				[ "$check_only" -eq 1 ] && continue
				if command -v sudo >/dev/null 2>&1; then
					dest_elevate=sudo
				else
					log_step "SKIPPED $dest_path (sudo unavailable)"
					failures=$((failures + 1))
					dest_ready=0
				fi
				;;
			*) log_warning "Unknown hook +$hook of $dest_path - ignored (known: +claude-plugin-dirs, +managed-settings)" ;;
		esac
	done
	if [ "$dest_ready" -eq 1 ] && [ "$dest_placement" != file ]; then
		prepare_folder "$dest_path" || dest_ready=0
	fi
}

# The manifest cache first: every row in scope gets its pinned clone (fetched once, through git)
# and its derived copy, so a fresh machine needs no separate Update-AiArtifacts. Not under --check;
# a row that cannot be fetched is a warning, and the roster then reports it as not fetched.
if [ "$check_only" -eq 0 ]; then
	while IFS=$'\t' read -r manifest_name manifest_file; do
		[ -n "$manifest_name" ] || continue
		while IFS=$'\t' read -r record text; do
			case $record in
				FETCHING) log_step "[$manifest_name] fetching $text" ;;
				FETCHED) log_step "[$manifest_name] fetched $text" ;;
				WARN) log_warning "[$manifest_name] $text" ;;
			esac
		done < <(ai_manifest_sync "$manifest_file" 2>/dev/null)
	done < <(ai_manifest_sources)
fi

dest_path=''
dest_ready=0
while IFS=$'\t' read -r record a b c d e; do
	case $record in
		WARN) log_warning "$a" ;;
		NOTE) log_step "$a" ;;
		DEST)
			finish_destination
			dest_kind=$a dest_placement=$b dest_hooks=$c dest_path=$d dest_harness=$e dest_links='' dest_elevate=''
			# -1: no item yet (opened by the first one).
			dest_ready=-1
			;;
		ITEM)
			[ "$dest_ready" -ne -1 ] || open_destination
			[ "$dest_ready" -eq 1 ] || continue
			key=$a.$b
			[ "$dest_placement" = file ] && key=$a.$b.$(basename "$d")
			if [ "$dest_placement" = copy ]; then
				copy_item "$key" "$c" "$d"
			elif [[ ,$dest_hooks, == *,managed-settings,* ]]; then
				managed_item "$key" "$c" "$d"
			else
				link_item "$key" "$c" "$d" "$dest_elevate"
			fi
			dest_links+="$d"$'\n'
			;;
	esac
done < <(ai_plan "${kinds[@]}")
finish_destination
if [ ${#kinds[@]} -eq 0 ] || [[ " ${kinds[*]} " == *" skills "* ]]; then
	deploy_repository_rows
fi

if [ "$check_only" -eq 1 ]; then
	if [ "$failures" -eq 0 ]; then
		log_success "AI artifacts fully deployed ($linked items)!"
	else
		log_warning "AI artifacts incomplete: $failures item(s) need deployment!"
	fi
	exit 0
fi

if [ "$failures" -eq 0 ]; then
	log_success "AI artifacts deployed ($linked items)!"
else
	log_error "AI artifacts deployment finished with $failures failure(s)!"
	exit 1
fi
