#!/usr/bin/env bash
# Deploy-AiMcpServers - adds the configured MCP servers to Claude Code and Codex.
#
# Usage: Deploy-AiMcpServers [--check]
#
# Unix counterpart of Deploy-AiMcpServers (WinuX AI module; design: docs/ai/mcp-servers.md). An MCP
# server is not an artifact a link can carry: each app keeps its servers inside its own
# configuration file, so they are written there.
#
# Reads Unix/config/ai-mcp-servers.conf (a deploy line, then one [section] per server, see its
# header), and adds every server to the apps the deploy line names for this machine type:
#
#   claude-code  with the claude CLI on PATH, every server the mcpServers block of ~/.claude.json
#                (${CLAUDE_CONFIG_DIR}/.claude.json when set) does not carry is added at user scope
#                (`claude mcp add --scope user`), one it carries with another definition is
#                removed (`claude mcp remove --scope user`) and added again, and one it carries as
#                configured is left alone. The file is only read: the CLI writes it. A missing CLI
#                only warns, and so does one resolved under /mnt/ (inside WSL, the Windows CLI
#                through interop, which would write the Windows profile).
#   codex        each server's [mcp_servers.<name>] table is written to ~/.codex/config.toml
#                (${CODEX_HOME}/config.toml when set), replacing that table and its subtables in
#                place or appending it; every other line, comments included, is kept. Codex reads
#                only stdio and streamable HTTP servers, so an sse server is skipped there.
#
# A bearer-token-env line names the environment variable holding a token: Claude Code gets an
# `Authorization: Bearer ${VAR}` header it expands when it starts, Codex bearer_token_env_var, so no
# secret is ever written. A server that signs in with OAuth needs that sign-in once per machine
# (/mcp in Claude Code, `codex mcp login <name>`). Servers are added and updated, never removed.
#
# --check (--dry-run, the Windows -WhatIf) reports what a run would add or update and changes
# nothing.
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
foundation_load config

# The Claude Code CLI; FOUNDATION_CLAUDE_CLI names another executable (the test suites set a name that
# never exists, or their stand-in), since foundation.sh puts Homebrew back on any trimmed PATH.
claude_cli=${FOUNDATION_CLAUDE_CLI:-claude}

foundation_normalize_args "$@"
set -- "${FOUNDATION_ARGS[@]}"
foundation_common_flags "$@"

check=0
for argument in "$@"; do
	case $argument in
		--check | --dry-run) check=1 ;;
		-v | --verbose) ;;
		*) foundation_die "Unknown argument: $argument (expected --check)" ;;
	esac
done

log_title "Deploy-AiMcpServers"
file=$(conf_path ai-mcp-servers.conf) || {
	log_warning "No MCP servers configured (ai-mcp-servers.conf) - nothing to deploy!"
	exit 0
}

# The apps: the last deploy line for this machine type (conf_lines drops the other types' lines).
deploy=''
while IFS= read -r line; do
	read -r kind rest <<<"$line"
	[ "${kind,,}" = deploy ] && deploy=${rest,,}
done < <(conf_lines "$file")

# The servers: one "SECTION<TAB>LINE" per data line of each section for this machine type.
spec=''
machine_lines=0
while IFS= read -r section; do
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		spec+="$section"$'\t'"$line"$'\n'
		read -r kind _ <<<"$line"
		[ "${kind,,}" = machine ] && machine_lines=1
	done < <(conf_section "$file" "$section")
done < <(conf_sections "$file")

if [ -z "$spec" ]; then
	log_warning "No MCP servers configured (ai-mcp-servers.conf) - nothing to deploy!"
	exit 0
fi
apps=''
for app in $deploy; do
	case $app in
		claude-code | codex) apps+=" $app" ;;
		*) log_warning "The deploy line names [$app], which Foundation cannot add MCP servers to (claude-code, codex) - skipped!" ;;
	esac
done
if [ -z "$apps" ]; then
	log_warning "No deploy line names an app for this machine type (ai-mcp-servers.conf) - nothing to deploy!"
	exit 0
fi

command -v python3 >/dev/null 2>&1 || foundation_die "python3 is required (reads ~/.claude.json, edits the Codex config.toml)"

machine=''
[ "$machine_lines" -eq 0 ] || machine=${CONF_MACHINE_TYPE:-$(foundation_machine_type)}

claude_path=''
if [[ $apps == *claude-code* ]]; then
	claude_path=$(command -v "$claude_cli" 2>/dev/null || true)
	if [ -z "$claude_path" ]; then
		log_warning "Claude Code CLI (claude) not found on PATH - its MCP servers are added once the Claude Code CLI is installed and this runs again!"
	elif [[ $claude_path == /mnt/* ]]; then
		log_warning "claude resolves to the Windows CLI [$claude_path], which would write the Windows profile - install the Claude Code CLI here so its MCP servers are added for this user!"
		claude_path=''
	fi
fi

claude_state=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
codex_config=${CODEX_HOME:-$HOME/.codex}/config.toml

# Python validates the servers (FOUNDATION_MCP_SPEC), runs the claude CLI with each argument exactly
# as configured and edits the TOML; it reports one "LEVEL<TAB>TEXT" line per message and ends with
# the failure count.
failures=''
while IFS=$'\t' read -r level text; do
	case $level in
		step) log_step "$text" ;;
		success) log_success "$text" ;;
		warning) log_warning "$text" ;;
		error) log_error "$text" ;;
		failures) failures=$text ;;
	esac
done < <(
	FOUNDATION_MCP_SPEC=$spec python3 - "$check" "$claude_path" "$claude_state" "$codex_config" "$apps" "$machine" <<'PY'
import json, os, re, subprocess, sys

check = sys.argv[1] == "1"
claude, claude_state, codex_path = sys.argv[2], sys.argv[3], sys.argv[4]
apps = sys.argv[5].split()
machine = sys.argv[6].lower()
NAME = re.compile(r"^[A-Za-z0-9_-]+$")
VARIABLE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
HEADER = re.compile(r"^[A-Za-z0-9!#$%&'*+.^_`|~-]+$")
failures = 0


def say(level, text):
    print(f"{level}\t{text}", flush=True)


def toml(value):
    escaped = value.replace("\\", "\\\\").replace('"', '\\"').replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")
    return f'"{escaped}"'


def canonical(entry):
    # One comparable form of a Claude Code entry: no type is stdio, streamable-http is http.
    def sorted_map(value):
        return {str(k): str(v) for k, v in sorted(value.items())} if isinstance(value, dict) else {}
    kind = entry.get("type") or "stdio"
    if kind == "streamable-http":
        kind = "http"
    arguments = entry.get("args") or []
    return json.dumps({
        "type": kind,
        "url": str(entry.get("url") or ""),
        "headers": sorted_map(entry.get("headers")),
        "command": str(entry.get("command") or ""),
        "args": [str(a) for a in arguments] if isinstance(arguments, list) else [],
        "env": sorted_map(entry.get("env")),
    }, sort_keys=True)


sections = {}
for raw in os.environ.get("FOUNDATION_MCP_SPEC", "").splitlines():
    if raw:
        section, line = raw.split("\t", 1)
        sections.setdefault(section, []).append(line)

servers = {}
uses_oauth = False
for name in sorted(sections, key=str.lower):
    problems = []
    url = command = transport = bearer = ""
    headers, env, arguments, machines = {}, {}, [], []
    for line in sections[name]:
        parts = line.split(None, 1)
        kind, rest = parts[0].lower(), (parts[1].strip() if len(parts) > 1 else "")
        if kind == "url":
            url = rest
        elif kind == "transport":
            transport = rest.lower()
        elif kind == "bearer-token-env":
            bearer = rest
        elif kind == "command":
            command = rest
        elif kind == "arg":
            arguments.append(rest)
        elif kind in ("header", "env"):
            pair = rest.split(None, 1)
            key, value = (pair[0] if pair else ""), (pair[1] if len(pair) > 1 else "")
            pattern = HEADER if kind == "header" else VARIABLE
            if not pattern.match(key):
                problems.append(f"has a {kind} line without a valid name => {line}")
            elif kind == "header":
                headers[key] = value
            else:
                env[key] = value
        elif kind == "machine":
            machines += [m.lower() for m in re.split(r"[\s,/]+", rest) if m]
        else:
            problems.append(f"has an unknown line (url, transport, header, bearer-token-env, command, arg, env, machine) => {line}")
    if machines and "all" not in machines and machine not in machines:
        continue
    if not NAME.match(name):
        problems.insert(0, "has an invalid name (letters, digits, - and _ only)")
    if bool(url) == bool(command):
        problems.append("needs exactly one url or command line")
    if url:
        if not re.match(r"^https?://\S+$", url):
            problems.append("has a url that is not an http(s) address")
        transport = transport or "http"
        if transport not in ("http", "sse"):
            problems.append("has a transport other than http or sse")
        if env or arguments:
            problems.append("has env or arg lines, which only a command server takes")
        if bearer and not VARIABLE.match(bearer):
            problems.append(f"has an invalid bearer-token-env [{bearer}]")
        if bearer and "Authorization" in headers:
            problems.append("sets both bearer-token-env and an Authorization header")
    elif command:
        if transport and transport != "stdio":
            problems.append("has a transport line, which only a url server takes")
        transport = "stdio"
        if headers or bearer:
            problems.append("has header or bearer-token-env lines, which only a url server takes")
    if problems:
        for problem in problems:
            say("error", f"MCP server [{name}] {problem} - skipped!")
        failures += 1
        continue

    if url:
        claude_headers = dict(headers)
        if bearer:
            claude_headers["Authorization"] = "Bearer ${" + bearer + "}"
        entry = {"type": transport, "url": url, "headers": claude_headers}
        add = ["mcp", "add", "--scope", "user", "--transport", transport, name, url]
        for key, value in claude_headers.items():
            add += ["--header", f"{key}: {value}"]
        if "Authorization" not in claude_headers:
            uses_oauth = True
        block = [f"[mcp_servers.{name}]", f"url = {toml(url)}"]
        if bearer:
            block.append(f"bearer_token_env_var = {toml(bearer)}")
        if headers:
            block.append("http_headers = { " + ", ".join(f"{toml(k)} = {toml(v)}" for k, v in sorted(headers.items())) + " }")
    else:
        entry = {"type": "stdio", "command": command, "args": arguments, "env": env}
        add = ["mcp", "add", "--scope", "user", name]
        for key, value in sorted(env.items()):
            add += ["-e", f"{key}={value}"]
        add += ["--", command] + arguments
        block = [f"[mcp_servers.{name}]", f"command = {toml(command)}"]
        if arguments:
            block.append("args = [" + ", ".join(toml(a) for a in arguments) + "]")
        if env:
            block.append("env = { " + ", ".join(f"{toml(k)} = {toml(v)}" for k, v in sorted(env.items())) + " }")
    servers[name] = {"transport": transport, "canonical": canonical(entry), "add": add, "block": block}

if not servers:
    say("warning", "No MCP server to deploy on this machine type!")

if "claude-code" in apps and servers and claude:
    current = {}
    try:
        with open(claude_state, encoding="utf-8") as handle:
            text = handle.read()
        document = json.loads(text) if text.strip() else {}
        current = document.get("mcpServers") if isinstance(document, dict) else {}
        current = current if isinstance(current, dict) else {}
    except FileNotFoundError:
        pass
    except ValueError:
        say("error", f"{claude_state} does not parse - Claude Code MCP servers not deployed!")
        failures += 1
        current = None
    for name, server in (servers.items() if current is not None else []):
        present = name in current
        if present and isinstance(current[name], dict) and canonical(current[name]) == server["canonical"]:
            say("step", f"Claude Code MCP server [{name}] already configured")
            continue
        if check:
            say("step", f"{'DIFFERS' if present else 'MISSING'} Claude Code MCP server [{name}]")
            failures += 1
            continue
        quiet = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        try:
            if present and subprocess.run([claude, "mcp", "remove", "--scope", "user", name], **quiet).returncode != 0:
                say("error", f"claude mcp remove --scope user [{name}] failed - run it by hand to see why!")
                failures += 1
                continue
            if subprocess.run([claude] + server["add"], **quiet).returncode == 0:
                say("success", f"{'Updated' if present else 'Added'} Claude Code MCP server [{name}]")
            else:
                say("error", f"claude mcp add [{name}] failed - run it by hand to see why!")
                failures += 1
        except OSError as error:
            say("error", f"claude could not be run for [{name}]: {error}")
            failures += 1

if "codex" in apps and servers:
    names = []
    for name, server in servers.items():
        if server["transport"] == "sse":
            say("warning", f"MCP server [{name}] is an sse server, which Codex does not read (stdio and streamable HTTP only) - not added to Codex!")
        else:
            names.append(name)
    try:
        text = open(codex_path, encoding="utf-8").read() if os.path.exists(codex_path) else ""
        newline = "\r\n" if "\r\n" in text else "\n"
        lines = text.splitlines()
        changed = []
        for name in names:
            block = servers[name]["block"]
            escaped = re.escape(name)
            header = re.compile(r'^\s*\[\s*mcp_servers\s*\.\s*(?:' + escaped + '|"' + escaped + r'")\s*(?:\.[^\]]*)?\]\s*(?:#.*)?$')
            kept, existing, start, inside = [], [], -1, False
            for line in lines:
                if re.match(r"^\s*\[", line):
                    inside = bool(header.match(line))
                    if inside and start < 0:
                        start = len(kept)
                # Comments in the table's stretch stay: they usually introduce the next table.
                if not inside or re.match(r"^\s*#", line):
                    kept.append(line)
                elif line.strip():
                    existing.append(line.strip())
            if start >= 0 and existing == block:
                say("step", f"Codex MCP server [{name}] already configured")
                continue
            if check:
                say("step", f"{'DIFFERS' if start >= 0 else 'MISSING'} Codex MCP server [{name}]")
                failures += 1
                continue
            if start >= 0:
                kept[start:start] = block + [""]
                changed.append(f"Updated Codex MCP server [{name}]")
            else:
                if kept and kept[-1].strip():
                    kept.append("")
                kept += block
                changed.append(f"Added Codex MCP server [{name}]")
            lines = kept
        if changed:
            os.makedirs(os.path.dirname(codex_path), exist_ok=True)
            with open(codex_path, "w", encoding="utf-8", newline="") as handle:
                handle.write(newline.join(lines) + newline)
            for message in changed:
                say("success", message)
    except OSError as error:
        say("error", f"Codex configuration {codex_path} not updated: {error}")
        failures += 1

if uses_oauth and not check:
    say("step", "A server that signs in with OAuth needs it once per machine: /mcp in Claude Code, `codex mcp login <name>` in Codex")
say("failures", str(failures))
PY
)
if [ -z "$failures" ]; then
	log_error "The MCP server deployment stopped before it finished (python3 failed) - nothing more was deployed!"
	exit 1
fi

if [ "$check" -eq 1 ]; then
	if [ "$failures" -eq 0 ]; then
		log_success "AI MCP servers fully deployed!"
	else
		log_warning "AI MCP servers incomplete: $failures item(s) need deployment!"
	fi
	exit 0
fi

if [ "$failures" -eq 0 ]; then
	log_success "AI MCP servers deployed!"
else
	log_error "AI MCP servers deployment finished with $failures failure(s)!"
	exit 1
fi
