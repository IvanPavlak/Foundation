#!/usr/bin/env bash
# NpmInstallAndStart - installs the npm dependencies, then starts the project. Alias: nir
#
# Usage: NpmInstallAndStart [ARGUMENTS...]
#
# npm install, then npm start even when the install failed, as on Windows (`npm install; npm
# start`); ARGUMENTS go to npm start (a Unix addition: Windows takes none). A leading -h or --help
# prints this header and installs nothing (NpmInstallAndStart -- --help reaches npm start).
_foundation=${BASH_SOURCE[0]}
while [ -L "$_foundation" ]; do
	_link=$(readlink "$_foundation")
	case $_link in /*) _foundation=$_link ;; *) _foundation=$(dirname "$_foundation")/$_link ;; esac
done
. "$(dirname "$_foundation")/../../../lib/foundation.sh" || exit 1
foundation_require_bash || exit 1
# A leading --help is this header; it never reaches the tool or starts a build.
case ${1:-} in -h | --help)
	foundation_usage "$0"
	exit 0
	;;
esac
command -v npm >/dev/null 2>&1 || foundation_die "npm is not installed - node comes from mise: brew install mise, then mise use --global node@lts"
npm install
exec npm start "$@"
