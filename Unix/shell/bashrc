# ~/.bashrc - a link chezmoi keeps to this file (Unix/home/symlink_dot_bashrc.tmpl).
# Everything lives in the shared rc; machine-specific lines go in ~/.shellrc.local.
# shellcheck shell=bash
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
DOTFILES_ROOT=${DOTFILES_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}
. "$DOTFILES_ROOT/Unix/shell/shellrc.sh"
