# shellcheck shell=bash

# ~/.bash_profile - a link chezmoi keeps to this file (Unix/home/symlink_dot_bash_profile.tmpl).
# Login bash reads only this file, so hand over to ~/.bashrc. An installer that appends to
# ~/.bash_profile edits this tracked file through the link: move what it adds to ~/.shellrc.local
# (Docker Desktop's ~/.docker/bin is already on PATH through shellrc.sh).
[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
